# Copy this file to ".env" and fill in your own values.
# The Analyzer page will still run without these — it just won't be
# able to reach the Flask API / save sessions to the database.

# Where your server.py Flask API is running (default matches server.py)
VITE_API_BASE_URL=http://127.0.0.1:5050

# Supabase project credentials (Settings -> API in your Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backends of the other three modules (each teammate's server.py; defaults shown)
VITE_ENV_RISK_API_URL=http://127.0.0.1:5051
VITE_CARDIO_API_URL=http://127.0.0.1:5052
VITE_ALERTS_API_URL=http://127.0.0.1:5053
